/* =========================
   BUILD 05 CONVERSION UPDATES
========================= */

.service button {
  width: 100%;
  margin-top: 22px;
  padding: 13px 16px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 10px;
  background: rgba(255,255,255,.04);
  color: #fff;
  font-weight: 700;
  cursor: pointer;
  transition: .2s ease;
}

.service button:hover {
  transform: translateY(-2px);
  background: rgba(255,255,255,.08);
}

.conversion {
  max-width: 1180px;
  margin: 30px auto 0;
  padding: 55px;
  border-radius: 24px;
  background:
    linear-gradient(135deg, rgba(30,110,255,.16), rgba(255,255,255,.025));
  border: 1px solid rgba(255,255,255,.09);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 35px;
}

.conversion h2 {
  max-width: 680px;
  margin: 12px 0;
}

.conversion p {
  max-width: 650px;
  color: #9da9ba;
  line-height: 1.7;
}

.what-we-need {
  margin-top: 30px;
  padding: 22px;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 15px;
  background: rgba(255,255,255,.025);
}

.what-we-need h3 {
  margin: 0 0 8px;
}

.what-we-need p {
  margin: 0;
}

.currency-note {
  max-width: 900px;
  margin: 0 auto 35px;
  padding: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22px;
  flex-wrap: wrap;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 16px;
  background: rgba(255,255,255,.025);
}

.currency-note div {
  display: flex;
  align-items: center;
  gap: 8px;
}

.currency-note span {
  font-size: 22px;
}

.currency-note strong {
  font-size: 15px;
}

.currency-note small {
  color: #8995a7;
}

.currency-note p {
  width: 100%;
  text-align: center;
  margin: 3px 0 0;
  color: #8995a7;
  font-size: 13px;
  line-height: 1.5;
}

.pricing-note {
  text-align: center;
  color: #9da9ba;
  margin-top: 25px;
}

.pricing-note strong {
  color: #fff;
}

@media (max-width: 800px) {
  .conversion {
    margin: 20px;
    padding: 32px 24px;
    flex-direction: column;
    align-items: flex-start;
  }

  .conversion .primary-btn {
    width: 100%;
    text-align: center;
  }

  .currency-note {
    margin-left: 20px;
    margin-right: 20px;
  }

  .service button {
    padding: 14px;
  }
}

@media (max-width: 520px) {
  .conversion {
    border-radius: 18px;
  }

  .currency-note {
    gap: 14px;
    padding: 18px;
  }

  .currency-note div {
    min-width: 120px;
  }

  .what-we-need {
    padding: 18px;
  }
}
